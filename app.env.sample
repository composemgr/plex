# Plex Media Server environment configuration
# Copy to app.env and adjust values as needed

# Timezone
TZ=America/New_York

# Service user/group IDs
SERVICE_USER=1000
SERVICE_GROUP=1000

# Hostname
BASE_HOST_NAME=plex.example.com

# Plex claim token - obtain from https://plex.tv/claim
# Required on first run to link to your Plex account, expires after 4 minutes
PLEX_CLAIM=replace-with-a-random-claim-token
