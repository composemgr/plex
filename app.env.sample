# Plex Media Server — environment variable reference
# Copy relevant lines to a .env file alongside docker-compose.yaml

# Timezone
TZ=America/New_York

# Service user/group IDs
SERVICE_USER=1000
SERVICE_GROUP=1000

# Hostname
BASE_HOST_NAME=${HOSTNAME}

# Plex claim token — obtain from https://plex.tv/claim (expires after 4 minutes)
# Required on first run to link to your Plex account
PLEX_CLAIM=claim-xxxxxxxxxxxxxxxxxxxx
